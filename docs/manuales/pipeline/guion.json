{
  "baseUrl": "http://localhost:8000",
  "viewport": { "width": 1440, "height": 900 },
  "login": { "url": "/login", "userSelector": "#login-email", "passwordSelector": "#login-password", "submitSelector": "form button[type=submit]" },
  "steps": [
    { "wait": 2500 },
    { "goto": "/pipeline" },
    { "wait": 4000 },
    { "screenshot": "01-tablero", "caption": "Tablero del pipeline con el resumen por etapa", "fullPage": false },
    { "click": "button:has-text(\"Nueva oportunidad\") >> nth=0" },
    { "wait": 1200 },
    { "fill": { "selector": "[role=dialog] input[placeholder=\"Suministro de equipo médico\"]", "value": "Suministro de mobiliario escolar" } },
    { "fill": { "selector": "[role=dialog] input[placeholder=\"Visitar a la unidad de compras\"]", "value": "Llamar a la unidad de compras" } },
    { "screenshot": "02-nueva-oportunidad", "caption": "Formulario para crear una oportunidad", "fullPage": false },
    { "goto": "/pipeline" },
    { "wait": 4000 },
    { "click": "[data-cap-kanban-column=\"oferta_presentada\"] [data-card-title] >> nth=1" },
    { "wait": 3000 },
    { "screenshot": "03-detalle", "caption": "Detalle de una oportunidad con sus datos", "fullPage": false },
    { "click": "[role=tab]:has-text(\"Participantes\")" },
    { "wait": 2500 },
    { "screenshot": "04-participantes", "caption": "Participantes del proceso y sus montos", "fullPage": false },
    { "goto": "/pipeline" },
    { "wait": 4000 },
    { "click": "[data-cap-kanban-column=\"oferta_presentada\"] .cap-kanban-card__menu >> nth=1" },
    { "wait": 1000 },
    { "screenshot": "05-menu-tarjeta", "caption": "Menú de acciones de una tarjeta en Oferta Presentada", "fullPage": false },
    { "goto": "/pipeline" },
    { "wait": 4000 },
    { "click": "[data-cap-kanban-column=\"oportunidad\"] .cap-kanban-card__menu >> nth=2" },
    { "wait": 1000 },
    { "click": "text=Mover a Oferta Presentada" },
    { "wait": 3000 },
    { "click": "[role=dialog] button:has-text(\"Agregar participante\")" },
    { "wait": 800 },
    { "fill": { "selector": "[role=dialog] input >> nth=0", "value": "CAP Honduras" } },
    { "screenshot": "06-presentar-oferta", "caption": "Ventana para presentar la oferta y registrar participantes", "fullPage": false },
    { "goto": "/pipeline" },
    { "wait": 4000 },
    { "click": "[data-cap-kanban-column=\"oferta_presentada\"] .cap-kanban-card__menu >> nth=1" },
    { "wait": 1000 },
    { "click": "text=Registrar como Ganada" },
    { "wait": 2500 },
    { "screenshot": "07-ganada", "caption": "Registrar una oportunidad como ganada", "fullPage": false },
    { "goto": "/pipeline" },
    { "wait": 4000 },
    { "click": "[data-cap-kanban-column=\"oferta_presentada\"] .cap-kanban-card__menu >> nth=1" },
    { "wait": 1000 },
    { "click": "text=Registrar como Perdida" },
    { "wait": 2500 },
    { "screenshot": "08-perdida", "caption": "Registrar una oportunidad como perdida e indicar quién ganó", "fullPage": false }
  ]
}
