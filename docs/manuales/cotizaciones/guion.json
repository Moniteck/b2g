{
  "baseUrl": "http://localhost:8000",
  "viewport": { "width": 1440, "height": 900 },
  "login": { "url": "/login", "userSelector": "#login-email", "passwordSelector": "#login-password", "submitSelector": "form button[type=submit]" },
  "steps": [
    { "wait": 2500 },
    { "goto": "/cotizaciones" },
    { "wait": 3500 },
    { "screenshot": "01-listado", "caption": "Listado de cotizaciones con su resumen", "fullPage": false },
    { "click": "button:has-text(\"Nueva cotización\") >> nth=0" },
    { "wait": 2500 },
    { "fill": { "selector": "[role=dialog] input[placeholder^=\"Cotización, Licitación\"]", "value": "Compra menor" } },
    { "click": "[role=dialog] button:has-text(\"Línea libre\")" },
    { "wait": 800 },
    { "screenshot": "02-nueva-cotizacion", "caption": "Formulario para crear una cotización", "fullPage": false },
    { "goto": "/cotizaciones" },
    { "wait": 3500 },
    { "click": "button[aria-label=\"Ver COT-QA-2026-0002\"]" },
    { "wait": 7000 },
    { "screenshot": "03-ver-cotizacion", "caption": "Vista de la cotización con su PDF y adjuntos", "fullPage": false },
    { "goto": "/cotizaciones" },
    { "wait": 3500 },
    { "click": "button[aria-label=\"Más acciones de COT-QA-2026-0001\"]" },
    { "wait": 1000 },
    { "screenshot": "04-mas-acciones", "caption": "Menú con más acciones de una cotización en Borrador", "fullPage": false },
    { "click": "text=Cambiar estado" },
    { "wait": 1500 },
    { "screenshot": "05-cambiar-estado", "caption": "Cambiar el estado de una cotización", "fullPage": false },
    { "goto": "/cotizaciones" },
    { "wait": 3500 },
    { "click": "button[aria-label=\"Más acciones de COT-QA-2026-0002\"]" },
    { "wait": 1000 },
    { "click": "text=Enviar por correo" },
    { "wait": 1500 },
    { "fill": { "selector": "[role=dialog] input[placeholder=\"compras@institucion.gob.hn\"]", "value": "compras@institucion.gob.hn" } },
    { "screenshot": "06-enviar-correo", "caption": "Enviar la cotización por correo", "fullPage": false },
    { "goto": "/cotizaciones" },
    { "wait": 3500 },
    { "click": "button[aria-label=\"Participantes de COT-QA-2026-0002\"]" },
    { "wait": 3000 },
    { "screenshot": "07-participantes", "caption": "Participantes del proceso de una cotización", "fullPage": false },
    { "goto": "/cotizaciones" },
    { "wait": 3500 },
    { "click": "button[aria-label=\"Marcar COT-QA-2026-0002 como Perdida\"]" },
    { "wait": 2500 },
    { "screenshot": "08-marcar-perdida", "caption": "Marcar una cotización como perdida", "fullPage": false }
  ]
}
