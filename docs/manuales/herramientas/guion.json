{
  "baseUrl": "http://localhost:8000",
  "viewport": { "width": 1440, "height": 900 },
  "login": {
    "url": "/login",
    "userSelector": "#login-email",
    "passwordSelector": "#login-password",
    "submitSelector": "form button[type=submit]"
  },
  "steps": [
    { "wait": 2500 },
    { "goto": "/inteligencia-competitiva" },
    { "wait": 3000 },
    { "screenshot": "01-competencia-listado", "caption": "Catálogo de competidores con sus indicadores de éxito" },
    { "click": "main button:has-text(\"Nuevo competidor\") >> nth=0" },
    { "wait": 1000 },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Nombre\"i >> nth=0", "value": "Suministros del Valle S. de R.L." } },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"RTN\"i >> nth=0", "value": "08019999000000" } },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Categoría\"i >> nth=0", "value": "Equipo médico" } },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Adjudicaciones\"i >> nth=0", "value": "4" } },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"No adjudicaciones\"i >> nth=0", "value": "7" } },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Instituciones donde participa\"i >> nth=0", "value": "SESAL, IHSS" } },
    { "screenshot": "02-competencia-nuevo", "caption": "Formulario para registrar un competidor", "fullPage": false },
    { "goto": "/relaciones-institucionales" },
    { "wait": 3000 },
    { "screenshot": "03-relaciones-listado", "caption": "Relaciones institucionales filtradas por próxima acción" },
    { "click": "main button:has-text(\"Nueva relación\") >> nth=0" },
    { "wait": 1000 },
    { "select": { "selector": "[role=dialog] >> internal:label=\"Tipo de relación\"i >> nth=0", "value": "Tomador de decisiones" } },
    { "select": { "selector": "[role=dialog] >> internal:label=\"Influencia\"i >> nth=0", "value": "Alta" } },
    { "select": { "selector": "[role=dialog] >> internal:label=\"Canal preferido\"i >> nth=0", "value": "Reunión presencial" } },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Interés en el POA\"i >> nth=0", "value": "Renovación de flota 2027" } },
    { "screenshot": "04-relaciones-nueva", "caption": "Formulario para registrar una relación institucional", "fullPage": false },
    { "goto": "/alertas-poa" },
    { "wait": 3000 },
    { "screenshot": "05-poa-listado", "caption": "Partidas POA con sus indicadores y filtros" },
    { "click": "main button:has-text(\"Nueva partida\") >> nth=0" },
    { "wait": 1000 },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Proyecto\"i >> nth=0", "value": "Adquisición de equipo de cómputo" } },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Partida presupuestaria\"i >> nth=0", "value": "42210" } },
    { "screenshot": "06-poa-nueva", "caption": "Formulario para registrar una partida POA", "fullPage": false },
    { "goto": "/consorcios" },
    { "wait": 3000 },
    { "screenshot": "07-consorcios-listado", "caption": "Listado de consorcios filtrado por estado" },
    { "click": "main button:has-text(\"Nuevo consorcio\") >> nth=0" },
    { "wait": 1000 },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Nombre\"i >> nth=0", "value": "Consorcio Vial Norte" } },
    { "click": "[role=dialog] button:has-text(\"Agregar miembro\")" },
    { "wait": 300 },
    { "click": "[role=dialog] button:has-text(\"Agregar miembro\")" },
    { "wait": 300 },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Nombre\"i >> nth=1", "value": "Constructora Ejemplo S.A." } },
    { "fill": { "selector": "[role=dialog] >> internal:label=\"Nombre\"i >> nth=2", "value": "Ingeniería Demo S. de R.L." } },
    { "click": "[role=dialog] button:has-text(\"Repartir en partes iguales\")" },
    { "wait": 500 },
    { "screenshot": "08-consorcios-nuevo", "caption": "Formulario de un consorcio con sus miembros", "fullPage": false },
    { "goto": "/calculadora-oferta" },
    { "wait": 3000 },
    { "fill": { "selector": "internal:label=\"Nombre del cálculo\"i", "value": "Lubricantes, lote 1" } },
    { "fill": { "selector": "[data-testid=linea-0] >> internal:label=\"Descripción\"i", "value": "Aceite de motor 15W-40, galón" } },
    { "fill": { "selector": "[data-testid=linea-0] >> internal:label=\"Cantidad\"i", "value": "50" } },
    { "fill": { "selector": "[data-testid=linea-0] >> internal:label=\"Costo unitario\"i", "value": "420" } },
    { "wait": 3000 },
    { "screenshot": "09-calculadora", "caption": "Calculadora de oferta con totales y escenarios de margen" },
    { "goto": "/generador-documentos" },
    { "wait": 3000 },
    { "screenshot": "10-generador", "caption": "Tipos de documento y el historial de documentos generados" },
    { "click": "main section button >> nth=0" },
    { "wait": 1000 },
    { "fill": { "selector": "[role=dialog] input >> nth=0", "value": "Secretaría de Salud" } },
    { "fill": { "selector": "[role=dialog] input >> nth=1", "value": "Lic. Ana Martínez, Jefa de Compras" } },
    { "fill": { "selector": "[role=dialog] textarea", "value": "Presentar a la empresa como proveedor de equipo médico y solicitar ser incluidos en los próximos procesos de compra." } },
    { "screenshot": "11-generador-formulario", "caption": "Formulario para redactar un documento con IA", "fullPage": false },
    { "goto": "/sops" },
    { "wait": 3000 },
    { "screenshot": "12-sops", "caption": "Procedimientos de la empresa y su lectura" },
    { "goto": "/capacitacion" },
    { "wait": 3000 },
    { "screenshot": "13-capacitacion", "caption": "Cursos de capacitación con tu avance" },
    { "click": "main article button >> nth=0" },
    { "wait": 1200 },
    { "screenshot": "14-capacitacion-leccion", "caption": "Lección de un curso abierta", "fullPage": false }
  ]
}
