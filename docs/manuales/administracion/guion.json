{
  "baseUrl": "http://localhost:8000",
  "viewport": { "width": 1440, "height": 900 },
  "login": { "url": "/login", "userSelector": "#login-email", "passwordSelector": "#login-password", "submitSelector": "form button[type=submit]" },
  "steps": [
    { "wait": 2500 },
    { "goto": "/administracion" },
    { "wait": 3000 },
    { "screenshot": "01-indice", "caption": "Página de Administración con sus tarjetas", "fullPage": false },
    { "goto": "/configuracion/usuarios" },
    { "wait": 3500 },
    { "screenshot": "02-usuarios", "caption": "Usuarios de la empresa y su rol", "fullPage": false },
    { "click": "button:has-text(\"Agregar usuario\") >> nth=0" },
    { "wait": 1200 },
    { "fill": { "selector": "[role=dialog] input >> nth=0", "value": "María Pérez" } },
    { "fill": { "selector": "[role=dialog] input[type=email]", "value": "maria.perez@example.hn" } },
    { "screenshot": "03-agregar-usuario", "caption": "Formulario para agregar un usuario a la empresa", "fullPage": false },
    { "goto": "/configuracion" },
    { "wait": 3500 },
    { "screenshot": "04-configuracion", "caption": "Configuración con los datos de la empresa para los membretes", "fullPage": false },
    { "goto": "/configuracion/mcp" },
    { "wait": 3500 },
    { "screenshot": "05-conexiones-mcp", "caption": "Conexiones MCP de asistentes de IA", "fullPage": false },
    { "goto": "/configuracion/auditoria" },
    { "wait": 3500 },
    { "screenshot": "06-auditoria", "caption": "Bitácora de auditoría de la empresa", "fullPage": false },
    { "click": "tbody tr >> nth=0" },
    { "wait": 1500 },
    { "screenshot": "07-detalle-auditoria", "caption": "Detalle de un registro de auditoría", "fullPage": false },
    { "goto": "/configuracion/diagnostico" },
    { "wait": 5000 },
    { "screenshot": "08-diagnostico", "caption": "Diagnóstico del servidor", "fullPage": false },
    { "goto": "/empresas" },
    { "wait": 3500 },
    { "screenshot": "09-empresas", "caption": "Empresas del grupo", "fullPage": false },
    { "click": "tbody tr >> nth=0" },
    { "wait": 3500 },
    { "screenshot": "10-ficha-empresa", "caption": "Datos fiscales de una empresa", "fullPage": false },
    { "click": "[role=tab]:has-text(\"Miembros\")" },
    { "wait": 2000 },
    { "screenshot": "11-miembros", "caption": "Miembros de una empresa y su rol", "fullPage": false },
    { "goto": "/post-adjudicacion?panel=feriados" },
    { "wait": 5000 },
    { "screenshot": "12-feriados", "caption": "Feriados que se descuentan de los plazos", "fullPage": false }
  ]
}
