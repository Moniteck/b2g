{
  "baseUrl": "http://localhost:8000",
  "viewport": { "width": 1440, "height": 900 },
  "login": { "url": "/login", "userSelector": "#login-email", "passwordSelector": "#login-password", "submitSelector": "form button[type=submit]" },
  "steps": [
    { "wait": 2500 },
    { "goto": "/calendario" },
    { "wait": 3500 },
    { "screenshot": "01-vista-mes", "caption": "Calendario en vista Mes con la leyenda de colores" },
    { "click": "button:has-text(\"Agenda\")" },
    { "wait": 2500 },
    { "screenshot": "02-vista-agenda", "caption": "Vista Agenda con los plazos del mes por día", "fullPage": false },
    { "click": "[data-day] button >> nth=1" },
    { "wait": 2500 },
    { "screenshot": "03-detalle-plazo", "caption": "Detalle de un plazo con sus recordatorios y el botón Marcar como atendido", "fullPage": false },
    { "goto": "/calendario" },
    { "wait": 3000 },
    { "click": "button:has-text(\"Nuevo evento\") >> visible=true" },
    { "wait": 1200 },
    { "fill": { "selector": "[data-autofocus]", "value": "Reunión de seguimiento con la alcaldía" } },
    { "fill": { "selector": "textarea", "value": "Revisar el avance de la entrega de equipos." } },
    { "screenshot": "04-nuevo-evento", "caption": "Formulario para crear un evento manual", "fullPage": false },
    { "goto": "/calendario" },
    { "wait": 3000 },
    { "click": "button:has-text(\"Reglas de recordatorio\")" },
    { "wait": 1200 },
    { "screenshot": "05-reglas-recordatorio", "caption": "Reglas de recordatorio de la empresa por tipo de plazo", "fullPage": false }
  ]
}
