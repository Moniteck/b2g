{
  "baseUrl": "http://localhost:8000",
  "viewport": { "width": 1440, "height": 900 },
  "login": { "url": "/login", "userSelector": "#login-email", "passwordSelector": "#login-password", "submitSelector": "form button[type=submit]" },
  "steps": [
    { "wait": 2500 },
    { "goto": "/licitaciones" },
    { "wait": 3000 },
    { "screenshot": "01-listado", "caption": "Lista de licitaciones con sus cifras y el próximo plazo de cada una" },
    { "click": "button[data-open-filters]" },
    { "wait": 1500 },
    { "screenshot": "02-filtros", "caption": "Hoja de filtros de las licitaciones", "fullPage": false },
    { "goto": "/licitaciones?vista=kanban" },
    { "wait": 3000 },
    { "screenshot": "03-kanban", "caption": "Licitaciones en tablero kanban por etapa", "fullPage": false },
    { "goto": "/licitaciones?vista=calendario" },
    { "wait": 3000 },
    { "screenshot": "04-calendario", "caption": "Calendario con los plazos de las licitaciones", "fullPage": false },
    { "goto": "/licitaciones" },
    { "wait": 3000 },
    { "click": "button[data-open-import]" },
    { "wait": 1500 },
    { "screenshot": "05-importar-captura", "caption": "Ventana para importar la captura de HonduCompras", "fullPage": false },
    { "goto": "/licitaciones" },
    { "wait": 3000 },
    { "click": "button:has-text(\"Nueva licitación\")" },
    { "wait": 1500 },
    { "fill": { "selector": "internal:label=\"Expediente\"i", "value": "LPN-DEMO-001-2026" } },
    { "fill": { "selector": "internal:label=\"Objeto\"i", "value": "Suministro de equipo de oficina para oficinas regionales" } },
    { "fill": { "selector": "internal:label=\"Nombre del proceso\"i", "value": "Licitación de equipo de oficina 2026" } },
    { "wait": 800 },
    { "screenshot": "06-nueva-licitacion", "caption": "Formulario para registrar una licitación a mano", "fullPage": false },
    { "goto": "/licitaciones/11" },
    { "wait": 3500 },
    { "screenshot": "07-ficha", "caption": "Ficha de una licitación con su plazo crítico, el siguiente paso y el resumen" },
    { "goto": "/licitaciones/11?tab=documentos" },
    { "wait": 3500 },
    { "screenshot": "08-documentos", "caption": "Pestaña Documentos de la licitación", "fullPage": false },
    { "goto": "/licitaciones/11?tab=analisis" },
    { "wait": 3500 },
    { "screenshot": "09-analisis-pliego", "caption": "Pestaña Análisis del pliego con la recomendación de la IA" },
    { "goto": "/licitaciones/13/pliego/7/revision" },
    { "wait": 4000 },
    { "screenshot": "10-revision-pliego", "caption": "Revisión de los datos del pliego con su cita y su página", "fullPage": false },
    { "goto": "/licitaciones/11?tab=oportunidad" },
    { "wait": 3500 },
    { "screenshot": "11-oportunidad", "caption": "Pestaña Oportunidad y cotizaciones con la matriz documental", "fullPage": false },
    { "goto": "/ia-licitaciones" },
    { "wait": 3000 },
    { "screenshot": "12-ia-licitaciones", "caption": "IA de licitaciones con las licitaciones vigentes", "fullPage": false },
    { "goto": "/historial" },
    { "wait": 3000 },
    { "screenshot": "13-historial-honducompras", "caption": "Historial HonduCompras con la tasa de adjudicación" },
    { "click": "button:has-text(\"Registrar proceso\") >> nth=0" },
    { "wait": 1500 },
    { "fill": { "selector": "internal:label=\"Número de proceso\"i", "value": "LPN-DEMO-002-2025" } },
    { "fill": { "selector": "internal:label=\"Nombre del proceso\"i", "value": "Suministro de papelería para oficinas centrales" } },
    { "wait": 800 },
    { "screenshot": "14-registrar-proceso", "caption": "Formulario para registrar un proceso en el historial", "fullPage": false }
  ]
}
