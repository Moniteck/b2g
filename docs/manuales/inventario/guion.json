{
  "baseUrl": "http://localhost:8000",
  "viewport": { "width": 1440, "height": 900 },
  "login": { "url": "/login", "userSelector": "#login-email", "passwordSelector": "#login-password", "submitSelector": "form button[type=submit]" },
  "steps": [
    { "wait": 2500 },
    { "goto": "/inventario" },
    { "wait": 4000 },
    { "screenshot": "01-listado", "caption": "Inventario con el resumen y la lista de productos", "fullPage": false },
    { "click": "button[aria-label^=\"Ver detalle de\"] >> nth=0" },
    { "wait": 2500 },
    { "screenshot": "02-detalle-producto", "caption": "Detalle de un producto", "fullPage": false },
    { "goto": "/inventario" },
    { "wait": 4000 },
    { "fill": { "selector": "input[aria-label^=\"Cantidad de\"] >> nth=0", "value": "10" } },
    { "fill": { "selector": "input[aria-label^=\"Cantidad de\"] >> nth=1", "value": "4" } },
    { "wait": 1200 },
    { "screenshot": "03-seleccion", "caption": "Productos elegidos con su subtotal, ISV y total", "fullPage": false },
    { "click": "button:has-text(\"Llevar a una cotización\") >> nth=0" },
    { "wait": 4500 },
    { "screenshot": "04-llevar-a-cotizacion", "caption": "Cotización nueva con los productos elegidos", "fullPage": false },
    { "goto": "/inventario" },
    { "wait": 4000 },
    { "click": "button:has-text(\"Historial\")" },
    { "wait": 3000 },
    { "screenshot": "05-historial", "caption": "Historial de sincronización con Blessing", "fullPage": false },
    { "click": "[role=dialog] tbody tr >> nth=0" },
    { "wait": 2000 },
    { "screenshot": "06-resultado-sincronizacion", "caption": "Resultado de una sincronización", "fullPage": false }
  ]
}
