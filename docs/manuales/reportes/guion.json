{
  "baseUrl": "http://localhost:8000",
  "viewport": { "width": 1440, "height": 900 },
  "login": { "url": "/login", "userSelector": "#login-email", "passwordSelector": "#login-password", "submitSelector": "form button[type=submit]" },
  "steps": [
    { "wait": 2500 },
    { "goto": "/reportes" },
    { "wait": 4000 },
    { "screenshot": "01-reportes", "caption": "Reportes con las cifras, el embudo comercial, adjudicado y cobrado y los indicadores del período" },
    { "select": { "selector": "section[aria-label=\"Filtros del reporte\"] select >> nth=1", "value": "cotizaciones" } },
    { "wait": 3500 },
    { "screenshot": "02-filtro-modulo", "caption": "Indicadores filtrados por el módulo Cotizaciones" },
    { "click": "button:has-text(\"Exportar\")" },
    { "wait": 800 },
    { "screenshot": "03-exportar", "caption": "Opciones para descargar el reporte en PDF, Excel o CSV", "fullPage": false },
    { "goto": "/kpis" },
    { "wait": 4000 },
    { "screenshot": "04-kpi-metas", "caption": "KPI y metas con el valor real de cada indicador frente a su meta" },
    { "click": "button:has-text(\"Fijar meta\") >> visible=true" },
    { "wait": 1200 },
    { "select": { "selector": "form select >> nth=0", "value": "cobros" } },
    { "wait": 500 },
    { "screenshot": "05-fijar-meta", "caption": "Formulario para fijar la meta de un indicador", "fullPage": false }
  ]
}
