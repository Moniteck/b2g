# CRM B2G - variables de entorno
# Solo lo estrictamente necesario: el resto tiene un valor por defecto correcto
# en config/. Idioma (es) y zona horaria (America/Tegucigalpa) son fijos.

# --- Aplicación ---
APP_NAME="CRM B2G"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Base de datos (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_b2g
DB_USERNAME=root
DB_PASSWORD=

# --- Sesión, caché y cola (tablas de la misma base) ---
# La cola necesita un worker y el scheduler debe estar corriendo: ver README.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Correo ---
# "log" no entrega nada (desarrollo). En producción: resend + RESEND_API_KEY.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="crm@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# --- Inteligencia artificial (OpenAI) ---
# Sin clave, el análisis de pliegos y el agente legal avisan y se trabaja a mano.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- MCP (ChatGPT, Claude) ---
# Opcional: dominios autorizados como redirección OAuth, separados por coma.
# Por defecto: https://chatgpt.com,https://claude.ai,https://claude.com
# MCP_REDIRECT_DOMAINS=https://chatgpt.com,https://claude.ai,https://claude.com

# --- Binarios del sistema (opcionales) ---
# Vacíos = se buscan en el PATH del servidor. Rellenar solo si no están en el PATH.
# TESSERACT_PATH: ruta completa al ejecutable de Tesseract.
# POPPLER_PATH: carpeta con pdftotext, pdftoppm, pdftocairo, pdfunite y pdfinfo.
# TESSERACT_PATH=
# POPPLER_PATH=

# Aplicación instalable (PWA) y notificaciones push de los plazos (config/pwa.php).
# Necesarias para el canal «push»: genérelas UNA vez con `php artisan pwa:vapid --subject=mailto:soporte@su-dominio`
# y copie las tres líneas aquí (cambiarlas obliga a cada dispositivo a reactivar los avisos).
# Sin ellas el canal push queda desactivado sin errores. Push exige HTTPS en producción.
# En Windows, OpenSSL necesita OPENSSL_CONF apuntando a un openssl.cnf para cifrar los avisos.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# PWA_ENABLED=true registra el service worker también con APP_ENV=local (solo pruebas, con `vite build`).
# PWA_ENABLED=
